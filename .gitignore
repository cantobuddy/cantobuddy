# Dependencies (installed by the host)
node_modules/

# Runtime data store — contains the admin password and learner progress.
# The app re-seeds this from data.js on first run, so it is safe to exclude.
db.json

# SQLite database and its WAL sidecar files. NEVER commit a live database:
# it holds password hashes, session tokens and learner progress.
cantobuddy.db
cantobuddy.db-wal
cantobuddy.db-shm
*.db
*.db-wal
*.db-shm
# Pre-migration copies, e.g. cantobuddy.db.pre-v2-backup — same contents as the
# live database, so they must never be committed either.
*.db.*
*.db.backup*

# WorkBuddy workspace metadata (project notes, app marker files)
.workbuddy-ai/
.workbuddy/
.wbapp_*.genie

# Local launcher with a machine-specific Node path
Start CantoBuddy.cmd

# Staging folder used for the browser-based GitHub upload
upload-to-github/

# Local deploy helper (contains no secrets — reads GITHUB_TOKEN from env)
tools/

# Review screenshots written by the *-shot.js scripts. Scratch output, never
# deployed (tools/deploy-to-github.js has an explicit FILES list) and never
# reviewed as source — but without this line `git status` shows ~130 PNGs and a
# real change is impossible to spot.
ui-preview/

# Local secrets — the GitHub deploy token lives here, never in the repo
.env
.env.*
!.env.example

# OS / editor cruft
*.log
.DS_Store
Thumbs.db

# Windows: a bad shell redirect (`2>nul` run under bash) creates a file literally
# named nul. It cannot be deleted through the normal file API (the name resolves
# to the NUL device), and it makes `git add -A` abort with "short read". Ignore
# it rather than leaving the whole tree un-committable.
nul

# Chrome user-data-dir leaked by banner generation (not a real asset)
promo/banners/_prof/
