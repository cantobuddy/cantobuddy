# Copy this file to `.env` (which is gitignored) and fill in the token.
#
#   cp .env.example .env
#
# Then run:  npm run deploy:dry     (shows what would be uploaded)
#            npm run deploy         (uploads as ONE commit)

# Fine-grained personal access token, scoped to cantobuddy/cantobuddy only,
# with "Contents: Read and write". Nothing else is needed.
GITHUB_TOKEN=

# Optional overrides — the defaults below are already correct.
# GH_OWNER=cantobuddy
# GH_REPO=cantobuddy
# GH_BRANCH=main

# --- Web Push reminders (optional) -------------------------------------------
# Without these the app runs normally and push is simply disabled.
# Generate a matching pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@cantobuddy.com
#
# How often the reminder ladder is checked, in minutes. It sends at most once a
# day (one 19:20–19:59 Hong Kong window) but must be asked far more often than
# that, or a sleeping host misses the evening entirely. Default 10.
# PUSH_SWEEP_MINUTES=10
